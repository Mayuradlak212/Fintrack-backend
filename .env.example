# ─── Application ─────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-before-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── SMTP / Email ────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your.email@gmail.com

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Optional. Without it, limits are enforced per worker process rather than
# shared across the fleet. Set this in production.
REDIS_URL=
RATE_LIMIT_REDIS_TIMEOUT_MS=50
# Only true when deployed behind a proxy that rewrites X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=true
