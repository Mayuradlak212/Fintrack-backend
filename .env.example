# ─── Application ─────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-before-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── SMTP / Email ────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your.email@gmail.com

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Optional. Without it, limits are enforced per worker process rather than
# shared across the fleet. Set this in production.
REDIS_URL=
RATE_LIMIT_REDIS_TIMEOUT_MS=50
# Only true when deployed behind a proxy that rewrites X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=true

# --- Redis high availability ------------------------------------------------
# Sentinel endpoints, comma separated. When set, the app resolves the current
# primary through Sentinel, so a failover needs no redeploy. Leave empty to use
# REDIS_URL directly (single node or managed Redis).
# Local stack: docker compose -f docker/redis-ha/docker-compose.yml up -d
REDIS_SENTINELS=
# Local stack value: 127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# Must match `sentinel monitor <name>` in docker/redis-ha/sentinel.conf.template
REDIS_MASTER_NAME=fintrack-primary
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_MS=200
REDIS_SENTINEL_TIMEOUT_MS=500

# --- Replication safety -----------------------------------------------------
# Replicas that must acknowledge a critical write (via WAIT) before it counts as
# durable. 0 disables the check.
REDIS_WAIT_REPLICAS=1
REDIS_WAIT_TIMEOUT_MS=200
# Raise on a shortfall instead of returning a result flagged not-durable.
REDIS_WAIT_RAISE_ON_SHORTFALL=false

# --- Redis health reporting -------------------------------------------------
REDIS_HEALTH_TIMEOUT_MS=1000
# Keep in step with `min-replicas-max-lag` in docker/redis-ha/redis.conf, so
# /api/health/redis warns before the primary starts rejecting writes.
REDIS_MAX_REPLICA_LAG_SECONDS=10
